# Browser options generated from root .env by make setup / make env-sync (GNU Make compatible).
# CHROME_PATH and CHROMIUM_EXECUTABLE_PATH are AUTOMATIC from Playwright Chromium.
# Do not hardcode Chrome paths here. Old browser paths are ignored by Make targets.
# Prefer sandbox enabled. Set to 1 only on disposable isolated QA hosts when required.
LHCI_CHROME_NO_SANDBOX=0
