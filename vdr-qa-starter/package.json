{
  "name": "virtual-data-room-qa",
  "private": true,
  "version": "0.20.0",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:security": "playwright test --grep @security --grep-invert @mutation",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:mutation": "node scripts/guard-mutation.mjs && playwright test --project=api --grep @mutation",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "security:repo": "node scripts/scanrepo.mjs",
    "qa:check": "npm run typecheck && npm run test:smoke",
    "test:framework": "node --test tests/unit/*.test.mjs",
    "browser:check": "python3 scripts/check-chromium.py",
    "lighthouse:check": "node scripts/lighthouse-run.mjs check",
    "lighthouse:public": "node scripts/lighthouse-run.mjs public",
    "lighthouse:auth": "node scripts/lighthouse-run.mjs auth",
    "lighthouse:flow": "node scripts/lighthouse-flow.mjs",
    "lighthouse:verify": "node scripts/lighthouse-verify.mjs",
    "lighthouse:browser-check": "node scripts/lighthouse-run.mjs browser",
    "lighthouse:analyze": "node scripts/lighthouse-analyze.mjs",
    "qa:discover": "node scripts/qa-inventory.mjs discover",
    "qa:baseline": "node scripts/qa-inventory.mjs baseline",
    "qa:diff": "node scripts/qa-inventory.mjs diff",
    "test:qa:storage": "RUN_MUTATION_TESTS=1 node scripts/guard-storage.mjs && RUN_MUTATION_TESTS=1 playwright test --project=chromium tests/ui/pdf-storage-lifecycle.mutation.spec.ts",
    "qa:perf:smoke": "node scripts/k6-run.mjs smoke",
    "qa:perf:load": "node scripts/k6-run.mjs load",
    "qa:perf:stress": "node scripts/k6-run.mjs stress",
    "qa:perf:spike": "node scripts/k6-run.mjs spike",
    "qa:perf:soak": "node scripts/k6-run.mjs soak",
    "qa:perf:volume": "node scripts/k6-run.mjs volume",
    "qa:perf:scalability": "node scripts/k6-run.mjs scalability",
    "qa:perf:analyze": "node scripts/k6-analyze.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.0.0",
    "typescript": "^5.7.0",
    "@lhci/cli": "0.15.1",
    "lighthouse": "12.8.2",
    "puppeteer": "24.43.1"
  }
}
