# Read-only VDR QA settings. Automatically created from the root .env by make setup / make env-sync.
# Do NOT commit .env. Makefile does not overwrite existing secrets.
WEB_BASE_URL=https://virtual-data-room-ten.vercel.app
API_BASE_URL=https://virtual-data-room-production.up.railway.app
OWNER_EMAIL=
OWNER_PASSWORD=
# Optional separate Viewer credentials for permissions tests
VIEWER_EMAIL=
VIEWER_PASSWORD=
# Read-only inventory. Identifiers are generated in .qa-resources.env
QA_ROOM_NAME=My Data Room
QA_ROOM_ID=
QA_FILE_NAME=Overview.pdf
QA_FOLDER_NAME=
# Unknown remote API origins are forbidden unless explicitly approved.
QA_READONLY_ALLOW_REMOTE=0
QA_API_APPROVED_ORIGIN=
# Lighthouse is localhost-only by default, remote targets require separate approval.
# LHCI_WEB_BASE_URL=http://127.0.0.1:4173
# LHCI_CHROME_NO_SANDBOX=0
