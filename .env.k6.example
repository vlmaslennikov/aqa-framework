# Local-only k6 settings. Generated from root .env by make setup / make env-sync.
# These are GNU Make variable assignments, not shell exports.
K6_EXECUTION=docker
K6_DOCKER_IMAGE=grafana/k6:latest
K6_BASE_URL=http://127.0.0.1:3100
K6_LOCAL_QA_ACK=I_OWN_THIS_DISPOSABLE_QA_STACK
# Heavy profiles require explicit opt-in; do not enable by default:
# K6_HEAVY_ACK=I_ACCEPT_QA_LOAD
# For scalability comparisons set a label for each infrastructure topology:
# K6_SCALE_LABEL=two-cpu
# For 100,000 rows (only after capacity planning):
# QA_PERF_LARGE_ACK=I_ACCEPT_100K_METADATA_ROWS
# For a fully pinned image use K6_DOCKER_IMAGE=grafana/k6@sha256:<digest>
